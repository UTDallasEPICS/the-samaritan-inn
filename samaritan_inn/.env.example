# Copy to .env and fill in the placeholder values:  cp .env.example .env
#
# Only the first three variables are needed to boot the app. Everything under
# "Salesforce" is required solely for the caseworker appointment flow
# (/my-events). Without it the app runs fine and every other feature works;
# /api/get-available-slots returns 500.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# Resolved RELATIVE TO prisma/schema.prisma, so this lands at prisma/dev.db.
DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"

# SENSITIVE — generate your own, never commit a real value: openssl rand -base64 32
NEXTAUTH_SECRET="EXAMPLE_GENERATE_YOUR_OWN_SECRET"

# ---------------------------------------------------------------------------
# Salesforce (required only for appointment scheduling)
# ---------------------------------------------------------------------------
# Server-to-server OAuth via the client_credentials grant. The app authenticates
# as itself, not as the signed-in resident. See src/lib/salesforce.ts.

SF_LOGIN_URL="https://login.salesforce.com"
SF_INSTANCE_URL="https://your-org.my.salesforce.com"

# SENSITIVE — from the Salesforce Connected App. Never commit real values.
SF_CLIENT_ID="EXAMPLE_SALESFORCE_CLIENT_ID"
SF_CLIENT_SECRET="EXAMPLE_SALESFORCE_CLIENT_SECRET"

# Fallback calendar owner used when an API caller omits ownerId. Bookings are
# only accepted for the caseworkers below, so this must be one of them to work.
SF_OWNER_ID="EXAMPLE_15_TO_18_CHAR_SF_ID"

# The caseworkers residents can book with: 15-18 character Salesforce User ids.
# Names, titles, emails and phone numbers are read live from these Salesforce
# User records (src/lib/caseworkers.ts) — update details in Salesforce, not here.
NEXT_PUBLIC_SF_OWNER_1="EXAMPLE_15_TO_18_CHAR_SF_ID"
NEXT_PUBLIC_SF_OWNER_2="EXAMPLE_15_TO_18_CHAR_SF_ID"
NEXT_PUBLIC_SF_OWNER_3="EXAMPLE_15_TO_18_CHAR_SF_ID"

# Salesforce record every booked appointment is linked to (Event.WhatId), e.g.
# an Account id starting with 001. Leave empty to create Events without a link.
SF_DEFAULT_WHAT_ID="EXAMPLE_15_TO_18_CHAR_SF_ID"
